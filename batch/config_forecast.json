{
  "name": "s3-sink-weather-forecast",
  "connector.class": "io.confluent.connect.s3.S3SinkConnector",
  "tasks.max": "1",
  "topics": "weather_forecast_data",
  "s3.region": "us-east-1",
  "s3.bucket.name": "raw-weather-data",
  "store.url": "http://35.240.139.79:9000",
  "topics.dir": "forecast/raw",
  "storage.class": "io.confluent.connect.s3.storage.S3Storage",
  "format.class": "io.confluent.connect.s3.format.json.JsonFormat",
  "partitioner.class": "io.confluent.connect.storage.partitioner.TimeBasedPartitioner",
  "flush.size": "34",
  "rotate.schedule.interval.ms": "60000",
  "timezone": "Asia/Bangkok",
  "schema.compatibility": "NONE",
  "aws.access.key.id": "admin",
  "aws.secret.access.key": "password123",
  "path.format": "'year'=YYYY/'month'=MM/'day'=dd",
  "locale": "vi_VN",
  "partition.duration.ms": "86400000",
  "timestamp.extractor": "Wallclock",
  "s3.part.size": "5242880",
  "consumer.override.max.poll.records": "100"
}
